# URL HTTPS temporal del túnel local para el prototipo QA consumer. No es un secreto.
# NEXT_PUBLIC_QA_ORIGIN=https://example-tunnel.example

# Merchant backend (server only, except the explicitly public Mapbox token).
# Copy this file to .env.local locally; configure the same values in Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_PRICE_PLUS_MONTHLY_TEST=
STRIPE_PRICE_PLUS_YEARLY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_PRICE_PLUS_MONTHLY_LIVE=
STRIPE_PRICE_PLUS_YEARLY_LIVE=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_SERVER_ACCESS_TOKEN=
# Geoapify is the primary autocomplete provider. The public key is origin-restricted;
# the server key must never use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
GEOAPIFY_API_KEY=
RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
