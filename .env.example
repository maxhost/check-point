# URL HTTPS temporal del túnel local para el prototipo QA consumer. No es un secreto.
# NEXT_PUBLIC_QA_ORIGIN=https://example-tunnel.example

# Merchant backend (server only, except the explicitly public Mapbox token).
# Copy this file to .env.local locally; configure the same values in Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
# En prod = el dominio público servido (ej. https://checkpass.club). better-auth rechaza
# el signup/login si el origin del request no coincide con BETTER_AUTH_URL ni con la lista.
BETTER_AUTH_URL=http://localhost:3001
# Orígenes extra confiables, separados por coma (apex + www + previews). Opcional; se suman
# a BETTER_AUTH_URL. Acepta comodines de better-auth, ej: https://www.checkpass.club,https://*.vercel.app
BETTER_AUTH_TRUSTED_ORIGINS=
# EL ORIGEN PUBLICO CANONICO, y es OBLIGATORIA para el Checkout de Stripe (spec 0063).
# Sin ella `/api/billing/checkout` contesta **503 origin_not_configured** y el owner ve
# «El pago no está configurado todavía» — que es exactamente lo que pasó en el QA de prod.
# Es 503 y NO un fallback a `new URL(request.url).origin` a propósito: con la idempotencyKey
# fija, una primera sesión creada desde el apex dejaría las `*_url` clavadas ahí por 24 h.
# En prod va el dominio al que redirige todo: el apex hace 308 a www.
# MERCHANT_PUBLIC_ORIGIN=https://www.checkpass.club
MERCHANT_PUBLIC_ORIGIN=http://localhost:3001
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_PRICE_PLUS_MONTHLY_TEST=
STRIPE_PRICE_PLUS_YEARLY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_PRICE_PLUS_MONTHLY_LIVE=
STRIPE_PRICE_PLUS_YEARLY_LIVE=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_SERVER_ACCESS_TOKEN=
# Geoapify is the primary autocomplete provider. The browser key is origin-restricted;
# the server key is stored only in the environment and must never use NEXT_PUBLIC_.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
GEOAPIFY_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
# Consumer recovery OTP (server-only). Generate independent secrets, never reuse them.
RECOVERY_ENABLED=false
OTP_PROVIDER=clicksend
OTP_HMAC_SECRET=
# base64 encoding of exactly 32 random bytes
OTP_ENCRYPTION_KEY=
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=CheckPass
# Alternative provider; required only when OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Owner/staff password recovery by email OTP (spec 0046). All server-only:
# RESEND_API_KEY must never be exposed as NEXT_PUBLIC_.
# Off by default: with the gate false, /forgot-password and its API routes answer 503.
PASSWORD_RECOVERY_ENABLED=false
# resend (default) | console (dev/test only, never sends)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Verified sender in Resend, e.g. no-reply@checkpass.club
EMAIL_FROM=
