{
  "name": "mi-pasaporte",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:consumer": "turbo run dev --filter=@mi-pasaporte/consumer",
    "dev:merchant": "turbo run dev --filter=@mi-pasaporte/merchant",
    "dev:platform": "turbo run dev --filter=@mi-pasaporte/platform",
    "dev:public": "turbo run dev --filter=@mi-pasaporte/public",
    "db:migrate": "pnpm --filter @mi-pasaporte/db db:migrate",
    "qa:qr": "CLANG_MODULE_CACHE_PATH=/tmp/mi-pasaporte-swift-module-cache swift scripts/generate-qa-qr.swift",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "turbo run build",
    "verify": "node tools/verify.ts",
    "ci:status": "node tools/ci-status.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2"
  }
}
